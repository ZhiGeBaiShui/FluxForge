{
  "items": [
    {
      "key": "flow_machine",
      "base": "template",
      "template": "system_module_performance",
      "sprite": "flow_machine",
      "name": "流量机",
      "desc": "打开后是一块可自定义大小的网格，把流量装置放进去即可驱动流源。",
      "flavor": "它嗡嗡作响，像在抱怨自己被降级了。",
      "grid": "4x3",
      "itemTypes": [
        "MACHINE"
      ],
      "attachments": [
        "machine"
      ]
    },
    {
      "key": "ice_block",
      "base": "empty",
      "sprite": "ice_block",
      "name": "冰块",
      "desc": "吸收流源的热量，自身逐渐融化。\n融化后水分随流源带走。",
      "flavor": "握在手里有股刺骨的凉意。",
      "itemTypes": [
        "FLOW_DEVICE"
      ],
      "attachments": [
        "ice_block"
      ],
      "tags": [
        {
          "valueName": "ICE_BLOCK_TAG"
        },
        {
          "valueName": "CURRENT_PART_WATER",
          "valueInt": 1000000
        },
        {
          "valueName": "FLOW_TEMPERATURE",
          "valueFloat": -5.0
        }
      ],
      "statusLines": [
        {
          "tag": "CURRENT_PART_WATER",
          "label": "含冰量",
          "scale": 0.001,
          "format": "0.#",
          "unit": "g",
          "color": "LightBlue"
        },
        {
          "tag": "FLOW_TEMPERATURE",
          "label": "温度",
          "scale": 1,
          "format": "0.#",
          "unit": "℃",
          "color": "LightCyan",
          "valueType": "float"
        }
      ]
    },
    {
