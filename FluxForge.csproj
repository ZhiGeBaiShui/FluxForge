<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FluxForge</AssemblyName>
    <RootNamespace>FluxForge</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS0169;CS0414;CS0649;CS1591</NoWarn>
    <GameManagedDir>E:\SteamLibrary\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed</GameManagedDir>
    <!-- 开发参考资料/ 里有同名的 Assembly-CSharp.dll；SDK 会把项目内 None/Content 里的
         DLL 当作候选引用并优先于 HintPath，必须把这套本地资料排除出默认项。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);开发参考资料/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(GameManagedDir)\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时真正读取的嵌入资源；不要用 assets\*.png 通配，
         否则候选立绘、旧图集和设计稿都会进 DLL。 -->
    <EmbeddedResource Include="assets\items.json" />
    <EmbeddedResource Include="assets\sprites.json" />
    <EmbeddedResource Include="assets\flow_mask.json" />
    <EmbeddedResource Include="assets\flow_mask_body.png" />
    <EmbeddedResource Include="assets\flow_mask_edge.png" />
    <EmbeddedResource Include="assets\flow_mask_accent.png" />
    <EmbeddedResource Include="assets\flow_mask_wall.png" />
    <EmbeddedResource Include="assets\sfx_filter_chemical.wav" />
    <EmbeddedResource Include="assets\sfx_heater.wav" />
    <EmbeddedResource Include="assets\sfx_cooler.wav" />
    <EmbeddedResource Include="assets\sfx_coldtrap_base.wav" />
    <EmbeddedResource Include="assets\sfx_coldtrap_cross.wav" />
    <EmbeddedResource Include="assets\sfx_filter_crystal.wav" />
    <EmbeddedResource Include="assets\sfx_speed_up.wav" />
    <EmbeddedResource Include="assets\sfx_speed_down.wav" />
    <EmbeddedResource Include="assets\sfx_emitter_fire.wav" />
    <EmbeddedResource Include="assets\sfx_centrifuge_spin.wav" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- 官方模组资源约定：Textures/Items/<key>.png 必须与 DLL / manifest 同级。
         源文件放在 mod/ 下，构建时用 Link 去掉 mod\ 前缀。 -->
    <None Update="mod\Textures\Items\*.png">
      <Link>Textures\Items\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 人物立绘使用官方 Textures 根目录；Items 目录由物品贴图加载器读取。 -->
    <None Update="mod\Textures\*.png">
      <Link>Textures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
