<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FluxForge.Tests</AssemblyName>
    <RootNamespace>FluxForge.Tests</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试只编译逻辑层（src/Logic），保持「零游戏依赖」的独立可测性。
         主工程已引用游戏 Il2Cpp 程序集（mod 层需要），测试环境加载不了，
         故不 ProjectReference，直接编入逻辑层源码。 -->
    <Compile Include="..\..\src\Logic\**\*.cs" />
    <!-- 表现层的纯计算（粒子）也零 Unity 依赖，一并编入以便单测 -->
    <Compile Include="..\..\src\Presentation\**\*.cs" />
    <!-- 装置状态适配器 + 目录：依赖 GameItem，测试桩由 GameStubs.cs 提供。
         TagMapping 只编入 GameItemTags；FlowStock / FlowRuntime / Sync patch 等
         仍引用游戏类型，测试环境加载不了。 -->
    <Compile Include="..\..\src\Mod\TagMapping\Core\GameItemTags.cs" />
    <!-- 装置挂载编排（Bind → Host → Registry → Sync）同样只依赖 GameItem 桩。
         DeviceStateSync 引用的 ItemTagCommit 由 GameStubs.cs 提供测试桩，
         因此不包含 src/Mod/Common/Item/ItemTagCommit.cs（它引用游戏表现辅助）。 -->
    <Compile Include="..\..\src\Mod\DeviceState\Sync\DeviceStateSync.cs" />
    <Compile Include="..\..\src\Mod\DeviceServices\Core\DeviceHost.cs" />
    <Compile Include="..\..\src\Mod\DeviceServices\Core\DeviceRegistry.cs" />
    <Compile Include="..\..\src\Mod\DeviceServices\Core\ItemDeviceBinding.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Contracts\DeviceStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Contracts\DeviceStateFields.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Naming\FlowTagNaming.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Naming\FlowPropertyTags.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\IceBlockStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\CollectorStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\TemperatureConfigAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\FilterStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\TurnStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\LRightDownStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\TJunctionStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Adapters\DoubleEmitStateAdapter.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Catalog\DeviceDefinition.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Catalog\DeviceAdapterAttribute.cs" />
    <Compile Include="..\..\src\Mod\DeviceState\Catalog\DeviceAdapterCatalog.cs" />
  </ItemGroup>

</Project>
