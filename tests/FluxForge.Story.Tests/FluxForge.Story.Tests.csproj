<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>
  <ItemGroup>
    <!-- 编译实际剧情图、播放器和业务代码；只替换游戏/Unity 边界。 -->
    <None Include="../../mod/Localization/zh.csv" Link="Localization/zh.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../mod/Localization/en.csv" Link="Localization/en.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/items.json" Link="Data/items.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../mod/Books/starter_note.json" Link="Data/starter_note.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/Logic/**/*.cs" />
    <Compile Include="../../src/Story/Runtime/**/*.cs"
             Exclude="../../src/Story/Runtime/Bootstrap/**/*.cs;../../src/Story/Runtime/Direction/**/*.cs" />
    <Compile Include="../../src/Story/Runtime/Direction/NpcStoryHost.cs" />
    <Compile Include="../../src/Story/Runtime/Direction/Services/StoryNpcRuntime.cs" />
    <Compile Include="../../src/Story/Runtime/Direction/Services/NpcVisitAssembly.cs" />
    <Compile Include="../../src/Story/Npcs/AcidBuyer/**/*.cs" />
    <Compile Include="../../src/Story/Npcs/FlowEmitterMerchant/FlowEmitterMerchantProgress.cs" />
    <Compile Include="../../src/Story/Hospital/**/*.cs" />
  </ItemGroup>
</Project>
