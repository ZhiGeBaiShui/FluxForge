<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ProbablyBagMod.Tests</AssemblyName>
    <RootNamespace>ProbablyBagMod.Tests</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试只编译逻辑层（src/Logic），保持「零游戏依赖」的独立可测性。
         主工程已引用游戏 Il2Cpp 程序集（mod 层需要），测试环境加载不了，
         故不 ProjectReference，直接编入逻辑层源码。 -->
    <Compile Include="..\..\src\Logic\**\*.cs" />
  </ItemGroup>

</Project>
