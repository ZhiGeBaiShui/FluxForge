                Exclude="E:\SteamLibrary\steamapps\common\Probably Stolen Demo\MelonLoader\net6\MelonLoader.NativeHost.dll;E:\SteamLibrary\steamapps\common\Probably Stolen Demo\MelonLoader\net6\Il2CppInterop.Generator.dll;E:\SteamLibrary\steamapps\common\Probably Stolen Demo\MelonLoader\net6\AsmResolver*.dll;E:\SteamLibrary\steamapps\common\Probably Stolen Demo\MelonLoader\net6\Mono.Cecil*.dll;E:\SteamLibrary\steamapps\common\Probably Stolen Demo\MelonLoader\net6\Iced.dll" />
